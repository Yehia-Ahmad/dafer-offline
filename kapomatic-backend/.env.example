PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/kapomatic_warehouse

# Push notifications (Firebase Cloud Messaging)
# Absolute path to the Firebase service-account JSON, kept outside the repo.
# Windows: write the path unquoted, in single quotes, or with forward slashes,
# e.g. FIREBASE_SERVICE_ACCOUNT=C:/keys/kapomatic-firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT=
# Shared secret the mobile app sends in the X-Notifications-Key header.
NOTIFICATIONS_API_KEY=
