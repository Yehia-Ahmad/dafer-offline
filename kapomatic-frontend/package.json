{
  "name": "kapomatic-inventory-system",
  "version": "0.0.0",
  "description": "Kapomatic Inventory System",
  "author": "Kapomatic",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:offline": "ng build --configuration offline",
    "offline:vendor": "node scripts/offline/fetch-vendor.js",
    "offline:stage": "node scripts/offline/stage.js",
    "test:offline": "node scripts/offline/run-tests.js",
    "smoke:offline": "node scripts/offline/smoke-test.js",
    "electron:start:offline": "npm run build:offline && npm run offline:vendor && electron electron-offline/main.js",
    "electron:build:win:offline:dir": "npm run build:offline && npm run offline:vendor && npm run offline:stage && electron-builder --win --dir --config electron-builder.offline.json",
    "electron:build:win:offline": "npm run build:offline && npm run offline:vendor && npm run offline:stage && electron-builder --win nsis --config electron-builder.offline.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "clean": "node scripts/clean.js",
    "reinstall": "npm run clean && npm install"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.8",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@primeuix/themes": "^1.2.5",
    "angular-svg-icon": "^19.1.1",
    "angularx-qrcode": "^20.0.0",
    "chart.js": "^4.5.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "jspdf": "^3.0.2",
    "primeng": "^20.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.5",
    "@angular/cli": "^20.3.5",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2"
  }
}
