# Copy to .env and fill in. Never commit .env.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nota
# Required, at least 32 characters. The server refuses to start without it.
NOTA_JWT_SECRET=
# Required, at least 32 characters, different from NOTA_JWT_SECRET. Signs the customer website's tokens (/api/store).
# deploy/setup-server.sh generates it on the server. The server refuses to start without it.
NOTA_STORE_JWT_SECRET=
# Comma-separated list of browser origins allowed to call the API, e.g. http://localhost:4200
# Empty = same origin only (the normal case when nginx serves the app and proxies /api/).
CORS_ORIGINS=

# --- Production on the VPS (deploy/setup-server.sh writes /etc/nota/backend.env with these) ---
# NODE_ENV=production gives the short access log without query strings.
NODE_ENV=
# Listen only on this address. Production: 127.0.0.1 (nginx is the only way in). Empty = all interfaces.
NOTA_LISTEN_HOST=
# 1 when nginx (same machine) proxies to the backend: the client IP is read from X-Forwarded-For.
# Needed for the login lockout to work per client. Leave empty when the backend is reached directly.
NOTA_TRUST_PROXY=
# Milliseconds since epoch; tokens issued before it are refused (deploy/restore.sh sets it). Empty = off.
NOTA_SESSIONS_VALID_AFTER=

# Online Stage 6A: Web Push for new website orders (phone notifications). Generated on the server by deploy/update.sh when
# missing; never commit real values. Without them push is simply off.
# NOTA_VAPID_PUBLIC_KEY=
# NOTA_VAPID_PRIVATE_KEY=
# NOTA_VAPID_SUBJECT=https://your-shop-domain
