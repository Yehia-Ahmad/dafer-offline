# Nota: nginx site for @@DOMAIN@@ (rendered by setup-server.sh; placeholders: @@DOMAIN@@ @@PORT@@ @@STOREFRONT_PORT@@).
# /api/ and /health -> the backend; /admin/ -> the admin app (static files, built with baseHref /admin/);
# everything else -> the storefront (the server-side rendered customer website, 127.0.0.1:@@STOREFRONT_PORT@@).

server {
    listen 80;
    listen [::]:80;
    server_name @@DOMAIN@@;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # Ubuntu 24.04 ships nginx 1.24: http2 is a listen parameter there (the `http2 on;` directive needs 1.25.1+).
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @@DOMAIN@@;

    ssl_certificate     /etc/letsencrypt/live/@@DOMAIN@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@DOMAIN@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 1m;

    # Customer tracking tokens are in /order/<token> and /api/store/orders/track/<token>: they never reach this log (see conf.d/nota-ratelimit.conf).
    access_log /var/log/nginx/nota-access.log nota_masked;

    include /etc/nginx/snippets/nota-security-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml font/ttf;

    # Only the admin app is served from disk (<root>/admin/); the storefront is proxied.
    root /opt/nota/current/frontend;
    index index.html;

    # The API. 100m covers the category Excel import (backend limit 100 MB); JSON bodies are limited to 10mb by the app.
    # `^~` stops the regex search: without it a regex location (the storefront's hashed-file rule below) would win over this
    # plain prefix. The exact-match (`=`) locations further down still win over it.
    location ^~ /api/ {
        client_max_body_size 100m;
        include /etc/nginx/snippets/nota-proxy-api.conf;
        proxy_pass http://127.0.0.1:@@PORT@@;
    }

    # Login: 10 POSTs per minute per IP, burst 5, then 429 (zone nota_login, see conf.d/nota-ratelimit.conf).
    # The app's own lockout (5 wrong passwords per username + IP) still applies on top.
    location = /api/auth/login {
        limit_req zone=nota_login burst=5 nodelay;
        limit_req_status 429;
        limit_req_log_level warn;
        include /etc/nginx/snippets/nota-proxy-api.conf;
        proxy_pass http://127.0.0.1:@@PORT@@;
    }

    # Online Stage 3: the customer website's public API. Small bodies only (the backend limits them too).
    # `^~` here too: nginx uses the LONGEST matching prefix, and only that one's `^~` skips the regex locations.
    location ^~ /api/store/ {
        client_max_body_size 64k;
        include /etc/nginx/snippets/nota-proxy-api.conf;
        proxy_pass http://127.0.0.1:@@PORT@@;
    }

    # Placing an order: 10 POSTs per minute per IP, burst 5, then 429 (zone nota_store_order).
    location = /api/store/orders {
        client_max_body_size 64k;
        limit_req zone=nota_store_order burst=5 nodelay;
        limit_req_status 429;
        limit_req_log_level warn;
        include /etc/nginx/snippets/nota-proxy-api.conf;
        proxy_pass http://127.0.0.1:@@PORT@@;
    }

    # Online Stage 5B: pricing the cart (nothing is created). 60 POSTs per minute per IP, burst 20, then 429 (zone nota_store_quote).
    location = /api/store/orders/quote {
        client_max_body_size 64k;
        limit_req zone=nota_store_quote burst=20 nodelay;
        limit_req_status 429;
        limit_req_log_level warn;
        include /etc/nginx/snippets/nota-proxy-api.conf;
        proxy_pass http://127.0.0.1:@@PORT@@;
    }

    # Customer sign-in and registration: 10 POSTs per minute per IP each, burst 5, then 429 (zone nota_store_auth).
    # The app's own lockout (5 failures per phone + IP) still applies on top.
    location = /api/store/auth/login {
        client_max_body_size 64k;
        limit_req zone=nota_store_auth burst=5 nodelay;
        limit_req_status 429;
        limit_req_log_level warn;
        include /etc/nginx/snippets/nota-proxy-api.conf;
        proxy_pass http://127.0.0.1:@@PORT@@;
    }
    location = /api/store/auth/register {
        client_max_body_size 64k;
        limit_req zone=nota_store_auth burst=5 nodelay;
        limit_req_status 429;
        limit_req_log_level warn;
        include /etc/nginx/snippets/nota-proxy-api.conf;
        proxy_pass http://127.0.0.1:@@PORT@@;
    }

    location = /health {
        proxy_pass http://127.0.0.1:@@PORT@@/health;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The admin app lives at /admin/ (built with baseHref /admin/); its files are in <root>/admin/.
    location = /admin {
        return 301 /admin/;
    }

    # Never cache the admin entry page: a new release must be picked up at once.
    location = /admin/index.html {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/nota-security-headers.conf;
    }

    # Admin single page app: unknown paths under /admin/ go to the admin index.html.
    # `^~` stops the regex search, so nothing under /admin/ can reach the storefront's hashed-file rule below (it would proxy the
    # admin's fonts and icons to the storefront). The hashed-file cache rule is nested inside, so it only ever sees /admin/ paths.
    location ^~ /admin/ {
        try_files $uri $uri/ /admin/index.html;

        # Every hashed file the admin build emits (main-AB12CD34.js, styles-AB12CD34.css, media/fa-solid-900-AB12CD34.woff2, ...)
        # never changes: cache for a year. A missing one is a 404, never the index.html fallback.
        location ~ "^/admin/.+-[A-Z0-9]{8}\.(js|css|woff2|woff|ttf|eot|svg|png)$" {
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            include /etc/nginx/snippets/nota-security-headers.conf;
            try_files $uri =404;
        }
    }

    # The storefront's hashed build files (main-AB12CD34.js, styles-AB12CD34.css, fonts, images) never change: cache for a year.
    # Only paths outside /api/ and /admin/ get here (both are `^~` prefixes above).
    location ~ "^/.+-[A-Z0-9]{8}\.(js|css|woff2|woff|ttf|eot|svg|png)$" {
        include /etc/nginx/snippets/nota-proxy-storefront.conf;
        proxy_pass http://127.0.0.1:@@STOREFRONT_PORT@@;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/nota-security-headers.conf;
    }

    # Everything else is the storefront: home, categories, products, cart, checkout, account, /sitemap.xml, /robots.txt.
    location / {
        include /etc/nginx/snippets/nota-proxy-storefront.conf;
        proxy_pass http://127.0.0.1:@@STOREFRONT_PORT@@;
    }
}
